# build artifacts
build/
*.bin
*.coe
*.mem
*.mif
*.o
*.elf
*.asm
*.out
*.hex
*_image.vhd
*_wrapper.v
*.json
*.cf

# keep default VHDL memory images
!rtl/core/*_image.vhd

# logs and dumps
*.gdb_history
*.log
*.vcd
*.fst
*.ghw

# host executables
sw/image_gen/image_gen
*.exe

# riscv-arch-test artifacts
__pycache__
riscof_work

# temporary files and folders
*.bak
*.tmp
~*

# generated documentation stuff
/docs/doxygen_build/
/docs/public/

# Quartus build artifacts (projeto TCC em rtl/core)
/rtl/core/db/
/rtl/core/incremental_db/
/rtl/core/greybox_tmp/
/rtl/core/output_files_mnist_accel/
/rtl/core/simulation/
/rtl/core/*.ipregen.rpt
/rtl/core/.qsys_edit/
/rtl/core/output_*/
/rtl/core/*_assignment_defaults.qdf
/rtl/core/*.qws

# Quartus build artifacts (projetos do TCC em rtl/tcc)
/rtl/tcc/*/db/
/rtl/tcc/*/incremental_db/
/rtl/tcc/*/greybox_tmp/
/rtl/tcc/*/simulation/
/rtl/tcc/*/output_*/
/rtl/tcc/*/.qsys_edit/
/rtl/tcc/*/*.ipregen.rpt
/rtl/tcc/*/*_assignment_defaults.qdf
/rtl/tcc/*/*.qws
