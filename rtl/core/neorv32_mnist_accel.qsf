# -------------------------------------------------------------------------- #
# neorv32_mnist_accel.qsf
# Projeto Quartus integrado da Fase 3/4 do TCC: NEORV32 (RV32IMC) + XBUS +
# controlador SDRAM (2x IS42S16320D) + acelerador sistolico 8x8 INT8.
# Convive com kai.qsf (Fase 1, teste standalone) no mesmo diretorio -- projetos
# Quartus distintos podem compartilhar os mesmos arquivos-fonte.
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY neorv32_de2115_mnist_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Standard Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_mnist_accel
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Altera FPGA (VHDL)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name PROJECT_IP_REGENERATION_POLICY ALWAYS_REGENERATE_IP

# -------------------------------------------------------------------------- #
# Clock / reset / UART / LEDs (mesmos pinos usados em kai.qsf)
# -------------------------------------------------------------------------- #
set_location_assignment PIN_Y2 -to clk_i
set_location_assignment PIN_M23 -to key_n[0]
set_location_assignment PIN_M21 -to key_n[1]

set_location_assignment PIN_G9 -to uart0_txd_o
set_location_assignment PIN_G12 -to uart0_rxd_i

set_location_assignment PIN_G21 -to ledg_o[7]
set_location_assignment PIN_G22 -to ledg_o[6]
set_location_assignment PIN_G20 -to ledg_o[5]
set_location_assignment PIN_H21 -to ledg_o[4]
set_location_assignment PIN_E24 -to ledg_o[3]
set_location_assignment PIN_E25 -to ledg_o[2]
set_location_assignment PIN_E22 -to ledg_o[1]
set_location_assignment PIN_E21 -to ledg_o[0]
set_location_assignment PIN_G19 -to ledr_o[0]
set_location_assignment PIN_F19 -to ledr_o[1]
set_location_assignment PIN_E19 -to ledr_o[2]
set_location_assignment PIN_F21 -to ledr_o[3]
set_location_assignment PIN_F18 -to ledr_o[4]
set_location_assignment PIN_E18 -to ledr_o[5]
set_location_assignment PIN_J19 -to ledr_o[6]
set_location_assignment PIN_H19 -to ledr_o[7]

# -------------------------------------------------------------------------- #
# SDRAM (2x ISSI IS42S16320D-7, 32 bits combinados) -- pinos oficiais
# extraidos de DE2_115_pin_assignments.xlsx (Terasic)
# -------------------------------------------------------------------------- #
set_location_assignment PIN_Y7 -to dram_addr_o[12]
set_location_assignment PIN_AA5 -to dram_addr_o[11]
set_location_assignment PIN_R5 -to dram_addr_o[10]
set_location_assignment PIN_Y6 -to dram_addr_o[9]
set_location_assignment PIN_Y5 -to dram_addr_o[8]
set_location_assignment PIN_AA7 -to dram_addr_o[7]
set_location_assignment PIN_W7 -to dram_addr_o[6]
set_location_assignment PIN_W8 -to dram_addr_o[5]
set_location_assignment PIN_V5 -to dram_addr_o[4]
set_location_assignment PIN_P1 -to dram_addr_o[3]
set_location_assignment PIN_U8 -to dram_addr_o[2]
set_location_assignment PIN_V8 -to dram_addr_o[1]
set_location_assignment PIN_R6 -to dram_addr_o[0]

set_location_assignment PIN_R4 -to dram_ba_o[1]
set_location_assignment PIN_U7 -to dram_ba_o[0]

set_location_assignment PIN_V7 -to dram_cas_n_o
set_location_assignment PIN_AA6 -to dram_cke_o
set_location_assignment PIN_AE5 -to dram_clk_o
set_location_assignment PIN_T4 -to dram_cs_n_o
set_location_assignment PIN_U6 -to dram_ras_n_o
set_location_assignment PIN_V6 -to dram_we_n_o

set_location_assignment PIN_N8 -to dram_dqm_o[3]
set_location_assignment PIN_K8 -to dram_dqm_o[2]
set_location_assignment PIN_W4 -to dram_dqm_o[1]
set_location_assignment PIN_U2 -to dram_dqm_o[0]

set_location_assignment PIN_U1 -to dram_dq_io[31]
set_location_assignment PIN_U4 -to dram_dq_io[30]
set_location_assignment PIN_T3 -to dram_dq_io[29]
set_location_assignment PIN_R3 -to dram_dq_io[28]
set_location_assignment PIN_R2 -to dram_dq_io[27]
set_location_assignment PIN_R1 -to dram_dq_io[26]
set_location_assignment PIN_R7 -to dram_dq_io[25]
set_location_assignment PIN_U5 -to dram_dq_io[24]
set_location_assignment PIN_L7 -to dram_dq_io[23]
set_location_assignment PIN_M7 -to dram_dq_io[22]
set_location_assignment PIN_M4 -to dram_dq_io[21]
set_location_assignment PIN_N4 -to dram_dq_io[20]
set_location_assignment PIN_N3 -to dram_dq_io[19]
set_location_assignment PIN_P2 -to dram_dq_io[18]
set_location_assignment PIN_L8 -to dram_dq_io[17]
set_location_assignment PIN_M8 -to dram_dq_io[16]
set_location_assignment PIN_AC2 -to dram_dq_io[15]
set_location_assignment PIN_AB3 -to dram_dq_io[14]
set_location_assignment PIN_AC1 -to dram_dq_io[13]
set_location_assignment PIN_AB2 -to dram_dq_io[12]
set_location_assignment PIN_AA3 -to dram_dq_io[11]
set_location_assignment PIN_AB1 -to dram_dq_io[10]
set_location_assignment PIN_Y4 -to dram_dq_io[9]
set_location_assignment PIN_Y3 -to dram_dq_io[8]
set_location_assignment PIN_U3 -to dram_dq_io[7]
set_location_assignment PIN_V1 -to dram_dq_io[6]
set_location_assignment PIN_V2 -to dram_dq_io[5]
set_location_assignment PIN_V3 -to dram_dq_io[4]
set_location_assignment PIN_W1 -to dram_dq_io[3]
set_location_assignment PIN_V4 -to dram_dq_io[2]
set_location_assignment PIN_W2 -to dram_dq_io[1]
set_location_assignment PIN_W3 -to dram_dq_io[0]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dram_addr_o[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dram_ba_o[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dram_dq_io[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dram_dqm_o[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dram_cas_n_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dram_cke_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dram_clk_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dram_cs_n_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dram_ras_n_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dram_we_n_o

# -------------------------------------------------------------------------- #
# Fontes VHDL (todo o rtl/core, exceto o teste standalone da Fase 1)
# -------------------------------------------------------------------------- #

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
# -------------------------------------------------------------------------- #
# LCD 16x2 (HD44780) -- pinos conforme DE2_115_pin_assignments (Terasic)
# -------------------------------------------------------------------------- #
set_location_assignment PIN_M5 -to lcd_data_o[7]
set_location_assignment PIN_M3 -to lcd_data_o[6]
set_location_assignment PIN_K2 -to lcd_data_o[5]
set_location_assignment PIN_K1 -to lcd_data_o[4]
set_location_assignment PIN_K7 -to lcd_data_o[3]
set_location_assignment PIN_L2 -to lcd_data_o[2]
set_location_assignment PIN_L1 -to lcd_data_o[1]
set_location_assignment PIN_L3 -to lcd_data_o[0]
set_location_assignment PIN_M2 -to lcd_rs_o
set_location_assignment PIN_M1 -to lcd_rw_o
set_location_assignment PIN_L4 -to lcd_en_o
set_location_assignment PIN_L5 -to lcd_on_o
set_location_assignment PIN_L6 -to lcd_blon_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to lcd_data_o[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to lcd_rs_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to lcd_rw_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to lcd_en_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to lcd_on_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to lcd_blon_o

set_global_assignment -name SOURCE_FILE sdram_clk_pll_core.cmp
set_global_assignment -name SDC_FILE neorv32_mnist_accel.sdc
set_global_assignment -name VHDL_FILE neorv32_cfs.vhd
set_global_assignment -name VHDL_FILE neorv32_xbus_wb_gateway.vhd
